# ============================================================
# uniS — .gitignore
# ============================================================

# ---------- 环境与密钥 ----------
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.pfx
# ---------- 运行时日志 ----------
logs/
*.log

# ---------- 编译产物 ----------
/bin/
/tmp/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# ---------- Go 工具缓存 ----------
vendor/

# ---------- IDE ----------
.idea/
.vscode/
*.swp
*.swo
*.DS_Store
Thumbs.db

# ---------- Air 热重载 ----------
tmp/
air.toml

# ---------- 测试覆盖率 ----------
coverage.out
coverage.html

# ---------- 数据库本地文件 ----------
*.db
*.sqlite
*.sqlite3

